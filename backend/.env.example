# ============================================================================
# Mero Bazaar — Backend environment reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (must match POSTGRES_DB in docker-compose).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace

# --- Server -----------------------------------------------------------------
# Local development: 3001 (matches the frontend's default NEXT_PUBLIC_API_URL).
# Docker Compose overrides this to 3000 and maps 3000:3000.
PORT=3001
# Public origin of the frontend (used for CORS and password-reset links).
FRONTEND_URL=http://localhost:3000

# --- Auth / JWT -------------------------------------------------------------
# REQUIRED. High-entropy signing key (at least 32 random characters, e.g.
# `openssl rand -base64 48`). The backend refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Optional JWT issuer/audience (enforced on verification).
JWT_ISSUER=mero-bazaar-api
JWT_AUDIENCE=mero-bazaar-web

# Shared secret between the Next.js BFF and this API (used by /user/oauth-sync).
# REQUIRED. At least 16 random characters.
INTERNAL_API_SECRET=change-me-too-long-random-string

# --- OAuth (Next.js side) ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- SMS / OTP --------------------------------------------------------------
# 'mock' logs OTPs to the console (development only; never in production).
# Leave unset or use 'sparrow' in production.
SMS_PROVIDER=mock
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# --- Mail (nodemailer / Gmail) ----------------------------------------------
MAIL_USER=
MAIL_PASS=

# --- Payments ---------------------------------------------------------------
ESEWA_PRODUCT_CODE=
KHALTI_SECRET_KEY=
# Optional overrides (defaults point at the official sandbox/live URLs).
ESEWA_STATUS_CHECK_URL=https://epay.esewa.com.np/api/epay/transaction/status/
KHALTI_LOOKUP_URL=https://khalti.com/api/v2/epayment/lookup/

# --- Supabase / storage (optional) ------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Admin seed (prisma/seed_admin.ts) --------------------------------------
# REQUIRED when running the admin seed script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
